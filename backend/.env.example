# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed to git (see .gitignore).

# Flask's internal cookie-signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT signing secret (can be a different random value than SECRET_KEY).
JWT_SECRET=
JWT_EXPIRY_MINUTES=120

# Leave unset to use local SQLite (backend/cardiosense.db).
# For Postgres: postgresql://username:password@host:5432/dbname
DATABASE_URL=

# Get from https://aistudio.google.com/app/apikey
# ROTATE the two keys that were previously hardcoded in app.py and
# cardiosense_dashboard.html -- treat them as already compromised.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

FLASK_DEBUG=false
